# =====================================================
# GDriveGenie Environment Variables
# =====================================================
# 1. Copy this file to .env and fill in your values.
# 2. Run: python backend/scripts/setup_pocketbase.py
#    (generates JWT_SECRET and ENCRYPTION_KEY for you)
# =====================================================

# --- PocketBase (your in-house instance) ---
PB_URL=https://data.genericxinus.com
# PocketBase SYSTEM admin credentials (not the app user)
PB_ADMIN_EMAIL=your-pocketbase-system-admin@example.com
PB_ADMIN_PASSWORD=your-pocketbase-admin-password

# --- App secrets (generated by setup_pocketbase.py) ---
JWT_SECRET=
ENCRYPTION_KEY=

# --- URLs (adjust for your deployment) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Google Drive credentials ---
# Place your credentials.json in the config/ directory
CONFIG_DIR=./config
